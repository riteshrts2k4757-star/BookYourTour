{
  "name": "sarthi-travel-platform",
  "version": "1.0.0",
  "description": "Sarthi Travel Booking Platform & NaviBand Smart Band Ecosystem",
  "main": "server.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node backend/server.js",
    "dev:navi": "npm --prefix navi run server",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND,NAVI\" -c \"blue,green,magenta\" \"node backend/server.js\" \"npm --prefix frontend run dev\" \"npm --prefix navi run server\"",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "start:navi": "npm --prefix navi run server",
    "preview": "npm --prefix frontend run preview",
    "preview:frontend": "npm --prefix frontend run preview"
  },
  "author": "Ritesh Kumar",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.18.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "crypto": "^1.0.1",
    "debug": "^4.4.3",
    "dotenv": "^7.0.0",
    "express": "^4.16.4",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "stripe": "^22.0.1",
    "util": "^0.12.5",
    "validator": "^13.15.26",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "eslint": "^5.16.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "nodemon": "^3.1.13",
    "prettier": "^1.17.0"
  }
}
